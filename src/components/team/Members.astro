---
// Fundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import TeamEntry2 from "@/components/team/TeamEntry2.astro";
// Content
import { getCollection } from "astro:content";
const founders = ["maya-lombardi", "marco-bianchi"];
const team = (await getCollection("team")).sort((a, b) => {
  const rank = (id: string) => (founders.includes(id) ? founders.indexOf(id) : founders.length);
  return rank(a.id) - rank(b.id) || a.data.name.localeCompare(b.data.name);
});
---

<section>
  <Wrapper variant="standard" class="pb-24">
    <ul role="list" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
      {team.map((post, index) => <TeamEntry2 post={post} index={index} />)}
    </ul>
  </Wrapper>
</section>
