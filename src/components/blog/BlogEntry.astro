---
// Assets
import { Image } from "astro:assets";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
// Content
const { post } = Astro.props;
const url = "/blog/posts/" + post.id;
const { title, description, image, tags } = post.data;
const pubDate = new Date(post.data.pubDate).toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<article class="relative flex flex-col group">
  <a
    href={url}
    title={`Read more: ${title}`}
    aria-label={`Read blog post: ${title}`}
    class="absolute inset-0 z-10"></a>
  <div class="overflow-hidden bg-muted aspect-3/2">
    <Image
      src={image.url}
      alt={image.alt}
      width={800}
      class="object-cover size-full transition duration-500 ease-out group-hover:scale-103"
    />
  </div>
  <div class="flex items-center justify-between mt-5 gap-3">
    <Text tag="span" variant="textXS" class="uppercase text-foreground">
      {tags[0]}
    </Text>
    <Text tag="span" variant="textXS" class="uppercase text-muted-foreground">
      {pubDate}
    </Text>
  </div>
  <Text
    tag="h3"
    variant="textLG"
    class="mt-3 font-medium tracking-tight text-balance text-foreground group-hover:text-muted-foreground transition-colors"
  >
    {title}
  </Text>
  <Text tag="p" variant="textSM" class="mt-2 text-muted-foreground line-clamp-2">
    {description}
  </Text>
</article>
