---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { grid, mainCol, mainStart } from "@/components/fundations/containers/grid";
---

<section>
  <Wrapper variant="standard" class="pt-40 pb-16 lg:pt-52">
    <div class:list={["grid", grid]}>
      <div class:list={[mainCol, mainStart]}>
        <Text
          tag="h1"
          variant="displayLG"
          class="max-w-2xl tracking-tight text-balance text-foreground"
        >
          Notes from <em>on call</em>
        </Text>
        <Text tag="p" variant="textBase" class="max-w-lg mt-6 text-muted-foreground">
          How we build Navy, what we learn from outages, and practical advice
          for teams who carry the pager.
        </Text>
      </div>
    </div>
  </Wrapper>
</section>
