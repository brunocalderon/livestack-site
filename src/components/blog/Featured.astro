---
// Assets
import { Image } from "astro:assets";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import ArrowLink from "@/components/fundations/elements/ArrowLink.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Content
import { getCollection } from "astro:content";
const allPosts = (await getCollection("posts")).sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);
const [featured] = allPosts;
const featuredDate = new Date(featured.data.pubDate).toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<section>
  <Wrapper variant="standard">
    <article class="relative grid group lg:grid-cols-12">
      <a
        href={`/blog/posts/${featured.id}`}
        aria-label={`Read blog post: ${featured.data.title}`}
        class="absolute inset-0 z-10"></a>
      <div class="overflow-hidden bg-muted aspect-3/2 lg:col-span-8">
        <Image
          src={featured.data.image.url}
          alt={featured.data.image.alt}
          width={1400}
          class="object-cover size-full transition duration-500 ease-out group-hover:scale-103"
        />
      </div>
      <div class="flex flex-col p-6 gap-24 bg-inverse lg:col-span-4 lg:p-10">
        <div class="flex items-center justify-between gap-4">
          <Text tag="span" variant="textXS" class="uppercase text-inverse-foreground">
            {featured.data.tags[0]}
          </Text>
          <Text tag="span" variant="textXS" class="uppercase text-inverse-foreground/60">
            {featuredDate}
          </Text>
        </div>
        <div class="mt-auto">
          <Text
            tag="h2"
            variant="displaySM"
            class="tracking-tight text-balance text-inverse-foreground"
          >
            {featured.data.title}
          </Text>
          <Text tag="p" variant="textSM" class="mt-3 text-inverse-foreground/70 text-pretty">
            {featured.data.description}
          </Text>
          <ArrowLink tag="span" tone="inverse" class="mt-8">Read the post</ArrowLink>
        </div>
      </div>
    </article>
  </Wrapper>
</section>
