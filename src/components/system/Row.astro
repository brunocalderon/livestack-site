---
// One row on the site grid: the name and a note in the side column, the
// content in the main columns.
import Text from "@/components/fundations/elements/Text.astro";
import { grid, sideCol, mainCol } from "@/components/fundations/containers/grid";
interface Props {
  name: string;
  text?: string;
}
const { name, text } = Astro.props;
---

<div class={`grid grid-cols-1 py-12 border-b gap-y-6 border-border ${grid}`}>
  <div class={sideCol}>
    <Text tag="h2" variant="textSM" class="font-medium uppercase text-foreground">
      {name}
    </Text>
    {
      text && (
        <Text tag="p" variant="textSM" class="max-w-xs mt-2 text-muted-foreground text-pretty">
          {text}
        </Text>
      )
    }
  </div>
  <div class:list={["min-w-0", mainCol]}>
    <slot />
  </div>
</div>
