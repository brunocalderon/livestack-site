---
// Assets
import GradientShader from "@/components/assets/GradientShader.astro";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import LabeledGrid from "@/components/fundations/containers/LabeledGrid.astro";
// Icons
import Check from "@/components/fundations/icons/Check.astro";
// Content
import { plans } from "@/components/pricing/plans";
---

<section class="relative overflow-hidden">
  <div aria-hidden="true" class="absolute inset-x-0 top-0 h-160 arch-gradient"></div>
  <GradientShader class="absolute inset-x-0 top-0 w-full h-160" />
  <div data-nav-dark aria-hidden="true" class="absolute inset-x-0 top-0 h-80"></div>
  <Wrapper variant="standard" class="relative flex flex-col justify-center pt-32 pb-24 min-h-160">
    <LabeledGrid>
      <Text
        tag="h1"
        variant="displayLG"
        class="max-w-2xl tracking-tight text-balance text-inverse-foreground"
      >
        Pricing that <em>grows</em> with your stack
      </Text>
      <Text tag="p" variant="textBase" class="max-w-lg mt-6 text-inverse-foreground/70 text-pretty">
        Your first ten monitors are free. Paid plans add faster checks, more
        monitors and on-call. Every paid plan starts with a 14-day trial, no
        card needed.
      </Text>
    </LabeledGrid>
  </Wrapper>
  <Wrapper variant="standard" class="relative pb-24">
    <ul role="list" class="grid gap-16 sm:grid-cols-2 sm:gap-8 lg:grid-cols-4">
      {
        plans.map((plan) => {
          return (
            <li class="flex flex-col">
              <div class="flex items-baseline gap-3">
                <Text tag="h2" variant="textBase" class="font-medium text-foreground">
                  {plan.title}
                </Text>
                {plan.popular && (
                  <Text tag="span" variant="textXS" class="text-primary">
                    Most popular
                  </Text>
                )}
              </div>
              <p class="flex items-baseline gap-1.5 mt-24 lg:mt-32">
                <Text tag="span" variant="displayLG" class="tracking-tight text-foreground">
                  {plan.price}
                </Text>
                {plan.period && (
                  <Text tag="span" variant="textSM" class="text-muted-foreground">
                    {plan.period}
                  </Text>
                )}
              </p>
              <Text tag="p" variant="textSM" class="mt-3 text-muted-foreground text-pretty">
                {plan.description}
              </Text>
              <ul role="list" class="flex flex-col mt-10 gap-5">
                {plan.features.map((feature) => (
                  <li class="flex items-start gap-3">
                    <Check size="sm" class="mt-0.5 shrink-0 text-primary" aria-hidden="true" />
                    <div>
                      <Text tag="p" variant="textSM" class="font-medium text-foreground">
                        {feature.title}
                      </Text>
                      <Text tag="p" variant="textSM" class="mt-1 text-muted-foreground text-pretty">
                        {feature.text}
                      </Text>
                    </div>
                  </li>
                ))}
              </ul>
              <div class="pt-10 mt-auto">
                <Button isLink={true} href={plan.cta.href} size="base" variant={plan.popular ? "accent" : "muted"} class="w-full">
                  {plan.cta.text}
                </Button>
              </div>
            </li>
          );
        })
      }
    </ul>
  </Wrapper>
</section>
