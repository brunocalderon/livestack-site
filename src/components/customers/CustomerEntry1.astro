---
// Assets
import { Image } from "astro:assets";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import ArrowLink from "@/components/fundations/elements/ArrowLink.astro";
// Content
const { post } = Astro.props;
const url = "/customers/" + post.id;
const { customer, ctaTitle, logo, details } = post.data;
---

<li class="border-b border-r border-border">
  <a href={url} class="flex flex-col h-full p-6 gap-24 group transition-colors hover:bg-muted lg:gap-32">
    <div class="flex items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <Image src={logo.url} alt={logo.alt} width={48} height={48} class="size-6" />
        <Text tag="p" variant="textBase" class="font-medium text-foreground">
          {customer}
        </Text>
      </div>
      {
        details?.Industry && (
          <Text tag="p" variant="textXS" class="uppercase text-muted-foreground">
            {details.Industry}
          </Text>
        )
      }
    </div>
    <div class="flex flex-col gap-6 mt-auto">
      <Text tag="h3" variant="textLG" class="text-balance text-foreground">
        {ctaTitle}
      </Text>
      <ArrowLink tag="span" size="xs">Read the story</ArrowLink>
    </div>
  </a>
</li>
