---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import ArrowLink from "@/components/fundations/elements/ArrowLink.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import LabeledGrid from "@/components/fundations/containers/LabeledGrid.astro";
/** Set true to show the status page plans link */
const showPlansLink = false;
const features = [
  {
    title: "Genera demanda.",
    text: "El crecimiento comienza mucho antes de la primera compra. Diseñamos estrategias para aumentar tu visibilidad, conectar con las audiencias correctas y convertir cada punto de contacto en una oportunidad comercial.",
  },
  {
    title: "Maximiza cada oportunidad.",
    text: "Cada cliente, visita e interacción representa una oportunidad para generar más valor. Te ayudamos a identificar nuevas fuentes de ingresos, optimizar tu oferta comercial y aprovechar mejor cada momento de la experiencia.",
  },
  {
    title: "Haz que todo fluya.",
    text: "La tecnología debería simplificar tu negocio, no hacerlo más complejo. Conectamos sistemas, personas y procesos para eliminar obstáculos, reducir tareas manuales y hacer que cada interacción sea más rápida, simple y eficiente.",
  },
  {
    title: "Construye relaciones.",
    text: "Una transacción puede ser el comienzo de una relación duradera. Te ayudamos a conocer mejor a tus clientes, comprender sus preferencias y crear experiencias relevantes que los motiven a regresar. Porque crecer también significa conseguir que quienes ya te conocen sigan eligiéndote.",
  },
  {
    title: "Crece con inteligencia.",
    text: "Cada interacción genera información valiosa, pero su verdadero potencial está en lo que haces con ella. Unificamos datos, conectamos indicadores y transformamos información dispersa en conocimiento útil para tomar mejores decisiones.",
  },
];
---

<section>
  <Wrapper variant="standard" class="py-24">
    <LabeledGrid label="The experience lifecycle">
      <div class="flex flex-col gap-12">
        <div class="grid gap-x-10 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
          <Text
            tag="h2"
            variant="displayMD"
            class="tracking-tight text-pretty text-foreground sm:col-span-2 sm:max-w-none lg:col-span-3"
          >
            <span class="block">Antes, durante,</span>
            <span class="block"><em>y mucho después.</em></span>
          </Text>
          <Text
            tag="p"
            variant="textBase"
            class="max-w-none text-muted-foreground text-pretty sm:col-span-1 lg:col-span-3"
          >
            Cada experiencia representa una oportunidad para atraer, vender, conectar y fidelizar.
          </Text>
        </div>
        {showPlansLink && (
          <ArrowLink href="/pricing" class="mt-8">
            See status page plans
          </ArrowLink>
        )}
        <dl class="border-b border-border" data-experience-lifecycle-list>
          {
            features.map((feature) => (
              <div
                class="grid items-start py-6 border-t gap-2 sm:grid-cols-2 sm:gap-8 sm:items-stretch border-border"
                data-experience-lifecycle-row
              >
                <dt class="min-h-0">
                  <Text tag="span" variant="textBase" class="font-medium text-foreground">
                    {feature.title}
                  </Text>
                </dt>
                <dd class="min-h-0">
                  <Text tag="span" variant="textSM" class="text-muted-foreground text-pretty">
                    {feature.text}
                  </Text>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </LabeledGrid>
  </Wrapper>
</section>

<script>
  const equalizeLifecycleRows = (list: HTMLElement) => {
    const rows = [...list.querySelectorAll<HTMLElement>("[data-experience-lifecycle-row]")];
    if (rows.length === 0) return;

    rows.forEach((row) => {
      row.style.minHeight = "";
    });

    const maxHeight = Math.max(...rows.map((row) => row.getBoundingClientRect().height));
    const height = `${maxHeight}px`;
    rows.forEach((row) => {
      row.style.minHeight = height;
    });
  };

  const lists = document.querySelectorAll<HTMLElement>("[data-experience-lifecycle-list]");
  for (const list of lists) {
    const run = () => equalizeLifecycleRows(list);
    run();
    new ResizeObserver(run).observe(list);
    window.addEventListener("resize", run, { passive: true });
  }
</script>
