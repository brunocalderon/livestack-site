---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import ArrowLink from "@/components/fundations/elements/ArrowLink.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import LabeledGrid from "@/components/fundations/containers/LabeledGrid.astro";
const darkIndustryGrounds = new Set(["bg-inverse", "bg-primary"]);

const timeline = [
  {
    ground: "bg-inverse",
    title: ["Eventos", "& festivales"],
    text: "Productoras, conciertos, festivales, ferias y eventos deportivos.",
  },
  {
    ground: "bg-primary",
    title: ["Venues", "& entretenimiento"],
    text: "Teatros, estadios, arenas, centros de eventos, parques y espacios recreativos.",
  },
  {
    ground: "bg-mist",
    title: ["Clubs", "& nightlife"],
    text: "Discotecas, bares, pubs, lounges y beach clubs.",
  },
  {
    ground: "bg-lilac",
    title: ["Gastronomía", "& hospitalidad"],
    text: "Restaurantes, cafeterías, hoteles, resorts y food halls.",
  },
  {
    ground: "bg-muted",
    title: ["Fitness", "& wellness"],
    text: "Gimnasios, estudios deportivos, boxes, spas y centros de bienestar.",
  },
  {
    ground: "bg-frost",
    title: ["Comunidades", "& membresías"],
    text: "Clubes privados, comunidades, asociaciones y espacios de coworking.",
  },
];
/** Set true to show the alert channels link below the section intro */
const showAlertChannelsLink = false;
/** Set true to show supporting copy under each industry card title */
const showIndustryDescriptions = true;
---

<section id="industrias">
  <Wrapper variant="standard" class="py-24">
    <LabeledGrid label="Built for your industry">
      <div class="grid gap-x-10 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
        <Text
          tag="h2"
          variant="displayMD"
          class="tracking-tight text-pretty text-foreground sm:col-span-2 sm:max-w-none lg:col-span-3"
        >
          <span class="block">Diferentes negocios.</span>
          <span class="block"><em>Una misma ambición.</em></span>
        </Text>
        <Text
          tag="p"
          variant="textBase"
          class="max-w-none text-muted-foreground text-pretty sm:col-span-1 lg:col-span-2"
        >
          Las soluciones de Livestack están creadas para quienes reúnen personas, generan emociones y
          transforman momentos en experiencias memorables.
        </Text>
      </div>
      {showAlertChannelsLink && (
        <ArrowLink href="/integrations/home" class="mt-8">
          See every alert channel
        </ArrowLink>
      )}
      <ol
        slot="full"
        role="list"
        class="grid gap-x-0 gap-y-0 sm:grid-cols-2 lg:grid-cols-3"
      >
        {
          timeline.map((step) => {
            const onDarkGround = darkIndustryGrounds.has(step.ground);
            return (
              <li class:list={["flex flex-col justify-end p-6 aspect-3/2", step.ground]}>
                <div>
                  <Text
                    tag="p"
                    variant={showIndustryDescriptions ? "displayMD" : "displayLG"}
                    class:list={[
                      "tracking-tight text-pretty",
                      onDarkGround ? "text-inverse-foreground" : "text-foreground",
                    ]}
                  >
                    <span class="block">{step.title[0]}</span>
                    <span class="block">{step.title[1]}</span>
                  </Text>
                  {showIndustryDescriptions && (
                    <Text
                      tag="p"
                      variant="textSM"
                      class:list={[
                        "mt-1 min-h-10 text-pretty",
                        onDarkGround ? "text-inverse-foreground/75" : "text-muted-foreground",
                      ]}
                    >
                      {step.text}
                    </Text>
                  )}
                </div>
              </li>
            );
          })
        }
      </ol>
    </LabeledGrid>
  </Wrapper>
</section>
