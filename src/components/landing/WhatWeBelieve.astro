---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import LabeledGrid from "@/components/fundations/containers/LabeledGrid.astro";
const stats = [
  {
    value: "18",
    unit: "",
    label: "Check regions",
    text: "On six continents, each on two cloud providers.",
  },
  {
    value: "30",
    unit: "s",
    label: "Check interval",
    text: "On every plan, from the very first monitor.",
  },
  {
    value: "40",
    unit: "s",
    label: "Median time to alert",
    text: "From the first failed check to a phone ringing.",
  },
  {
    value: "2B",
    unit: "+",
    label: "Checks a month",
    text: "Across every region, every minute of the day.",
  },
];
/** Set true to show the stat figures grid */
const showStats = false;
---

<section id="nosotros">
  <Wrapper variant="standard" class="py-24">
    <LabeledGrid label="What we believe">
      <div class="grid gap-x-10 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
        <Text
          tag="h2"
          variant="displayMD"
          class="tracking-tight text-pretty text-foreground sm:col-span-2 sm:max-w-none lg:col-span-3"
        >
          <span class="block">La tecnología no debe ser un obstáculo para el negocio.</span>
          <span class="block"><em>Debe ser un acelerador.</em></span>
        </Text>
        <Text
          tag="p"
          variant="textBase"
          class="max-w-none text-muted-foreground text-pretty sm:col-span-1 lg:col-span-2"
        >
          En Livestack creemos que la tecnología no debe ser una capa adicional sobre tu negocio, sino una capacidad
          estratégica que transforme la manera en que opera, evoluciona y genera valor. Creamos soluciones para que
          las personas dediquen menos tiempo a gestionar sistemas y más tiempo a crear momentos que importan.
        </Text>
      </div>
      {
        showStats && (
          <div slot="full">
            <dl class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
              {stats.map((stat) => (
                <div class="flex flex-col">
                  <dt class="order-2 mt-6">
                    <Text tag="span" variant="textBase" class="font-medium text-foreground">
                      {stat.label}
                    </Text>
                  </dt>
                  <dd class="order-1">
                    <Text tag="span" variant="display3XL" class="tracking-tight text-foreground">
                      {stat.value}
                      {stat.unit && <span class="text-primary">{stat.unit}</span>}
                    </Text>
                  </dd>
                  <dd class="order-3 mt-1">
                    <Text tag="p" variant="textSM" class="text-muted-foreground text-pretty">
                      {stat.text}
                    </Text>
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        )
      }
    </LabeledGrid>
  </Wrapper>
</section>
