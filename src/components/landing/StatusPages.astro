---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import ArrowLink from "@/components/fundations/elements/ArrowLink.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import LabeledGrid from "@/components/fundations/containers/LabeledGrid.astro";
/** Set true to show the status page plans link */
const showPlansLink = false;
const features = [
  {
    title: "1. Genera demanda.",
    text: "Llega a nuevas audiencias y transforma el interés en ventas.",
  },
  {
    title: "2. Maximiza cada oportunidad.",
    text: "Monetiza accesos, productos, servicios y experiencias.",
  },
  {
    title: "3. Haz que todo fluya.",
    text: "Simplifica los pagos, los accesos y la operación.",
  },
  {
    title: "4. Construye relaciones.",
    text: "Convierte asistentes ocasionales en clientes recurrentes.",
  },
  {
    title: "5. Crece con inteligencia.",
    text: "Transforma los datos de hoy en las oportunidades de mañana.",
  },
];
---

<section>
  <Wrapper variant="standard" class="py-24">
    <LabeledGrid label="The experience lifecycle">
      <div class="grid gap-12 lg:grid-cols-9 lg:gap-x-8">
        <div class="lg:col-span-4">
          <div class="grid gap-x-10 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
            <Text
              tag="h2"
              variant="displayMD"
              class="tracking-tight text-pretty text-foreground sm:col-span-2 sm:max-w-none lg:col-span-3"
            >
              <span class="block">Antes, durante,</span>
              <span class="block"><em>y mucho después.</em></span>
            </Text>
            <Text
              tag="p"
              variant="textBase"
              class="max-w-none text-muted-foreground text-pretty sm:col-span-1 lg:col-span-1"
            >
              Cada experiencia representa una oportunidad para atraer, vender, conectar y fidelizar.
            </Text>
          </div>
          {showPlansLink && (
            <ArrowLink href="/pricing" class="mt-8">
              See status page plans
            </ArrowLink>
          )}
        </div>
        <dl class="border-b lg:col-span-5 border-border" data-experience-lifecycle-list>
          {
            features.map((feature) => (
              <div
                class="grid items-start py-6 border-t gap-2 sm:grid-cols-2 sm:gap-8 sm:items-stretch border-border"
                data-experience-lifecycle-row
              >
                <dt class="min-h-0">
                  <Text tag="span" variant="textBase" class="font-medium text-foreground">
                    {feature.title}
                  </Text>
                </dt>
                <dd class="min-h-0">
                  <Text tag="span" variant="textSM" class="text-muted-foreground text-pretty">
                    {feature.text}
                  </Text>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </LabeledGrid>
  </Wrapper>
</section>

<script>
  const equalizeLifecycleRows = (list: HTMLElement) => {
    const rows = [...list.querySelectorAll<HTMLElement>("[data-experience-lifecycle-row]")];
    if (rows.length === 0) return;

    rows.forEach((row) => {
      row.style.minHeight = "";
    });

    const maxHeight = Math.max(...rows.map((row) => row.getBoundingClientRect().height));
    const height = `${maxHeight}px`;
    rows.forEach((row) => {
      row.style.minHeight = height;
    });
  };

  const lists = document.querySelectorAll<HTMLElement>("[data-experience-lifecycle-list]");
  for (const list of lists) {
    const run = () => equalizeLifecycleRows(list);
    run();
    new ResizeObserver(run).observe(list);
    window.addEventListener("resize", run, { passive: true });
  }
</script>
