---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import LabeledGrid from "@/components/fundations/containers/LabeledGrid.astro";

type SolutionStep = {
  title: string;
  kicker: string;
  text: string;
  /** Product marketing site; kicker becomes a link when set */
  href?: string;
};

const steps: SolutionStep[] = [
  {
    title: "Backstage",
    kicker: "Strategy, Growth & Technology",
    text: "Combinamos consultoría, marketing, growth y tecnología para acelerar tu crecimiento, optimizar operaciones y transformar oportunidades en resultados.",
    href: "",
  },
  {
    title: "Arrival",
    kicker: "Ticketing & Access",
    text: "Infraestructura flexible que maximiza tus ingresos, mantiene el control transaccional y entrega información completa de tus asistentes.",
    href: "https://heyarrival.com",
  },
  {
    title: "NAW",
    kicker: "Wallet & Cashless Payments",
    text: "Unifica pagos, cashless, puntos de venta, compra autoatendida y gestión de pedidos. Reduce esperas, agiliza entregas y libera a tu equipo para atender mejor.",
    href: "https://naw.cash",
  },
  {
    title: "Gathr",
    kicker: "Growth & Performance",
    text: "Convierte cada interacción en una oportunidad de crecimiento. Landing pages, formularios y campañas, gestion de rrpp y audiencias propias.",
    href: "https://gathrkit.com",
  },
  {
    title: "Signal",
    kicker: "Marketing & Engagement",
    text: "Conecta con tu audiencia en el momento indicado y a través del canal correcto. Segmenta tus contactos y automatiza campañas personalizadas.",
    href: "https://signalmailing.com",
  },
  {
    title: "Círculo",
    kicker: "Membership & Loyalty",
    text: "Membresías, beneficios exclusivos y experiencias personalizadas que fortalecen tu comunidad y aumentan el valor de cada cliente a lo largo del tiempo.",
    href: "https://usacirculo.com",
  },
];

/** Set true to show product names (e.g. Acceso Premier) above each kicker */
const showSolutionTitles = false;
/** Set true to link kickers to each step's `href` */
const showSolutionLinks = false;
/** Set true to show the product grid below the section intro */
const showSolutionGrid = false;
const serviceIntro = {
  lead: "Un servicio 360° para hacer crecer tu negocio.",
  paragraphs: [
    "Combinamos estrategia, tecnología, marketing y ejecución para transformar desafíos en oportunidades de crecimiento.",
    "Nos integramos a tu equipo, conectamos las herramientas que ya utilizas y desarrollamos nuevas capacidades para simplificar tu operación, mejorar la experiencia de tus clientes y generar resultados medibles.",
  ],
};

const servicePillars = [
  {
    title: "Estrategia",
    tagline: "Transformamos oportunidades en planes de acción.",
    text: "Entendemos tu negocio, identificamos oportunidades de mejora y diseñamos estrategias que conectan tus objetivos con iniciativas concretas de crecimiento.",
  },
  {
    title: "Crecimiento",
    tagline: "Atraemos, convertimos y fidelizamos.",
    text: "Combinamos marketing, creatividad, datos y experimentación para conectar con nuevas audiencias, optimizar conversiones y construir relaciones duraderas con tus clientes.",
  },
  {
    title: "Tecnología",
    tagline: "Hacemos que la tecnología trabaje para ti.",
    text: "Desarrollamos soluciones, integramos plataformas y automatizamos procesos para que tu negocio opere de forma más inteligente, eficiente y escalable.",
  },
  {
    title: "Ejecución",
    tagline: "De las ideas a los resultados.",
    text: "No nos quedamos en las recomendaciones. Trabajamos junto a tu equipo para implementar soluciones, medir su impacto y optimizar continuamente cada iniciativa.",
  },
];

const serviceClose = {
  text: "Cada negocio tiene sus propios desafíos, oportunidades y ambiciones. En Livestack combinamos visión estratégica, experiencia tecnológica y capacidad de ejecución para ayudarte a dar el siguiente paso. Desde identificar nuevas oportunidades hasta diseñar, implementar y optimizar soluciones, trabajamos junto a tu equipo para transformar ideas en resultados concretos y construir las capacidades que impulsarán tu crecimiento.",
  cta: "Conversemos sobre tu negocio",
};
---

<section id="soluciones">
  <Wrapper variant="standard" class="flex flex-col justify-center py-24">
    <LabeledGrid label="The service">
      <div class="grid gap-x-10 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
        <Text
          tag="h2"
          variant="displayMD"
          class="tracking-tight text-pretty text-foreground sm:col-span-2 sm:max-w-none lg:col-span-3"
        >
          <span class="block">Todo funciona mejor,</span>
          <span class="block">cuando <em>está conectado.</em></span>
        </Text>
        <div class="grid max-w-none gap-y-4 sm:col-span-1 lg:col-span-2">
          <Text tag="p" variant="textBase" class="font-medium text-pretty text-foreground">
            {serviceIntro.lead}
          </Text>
          {serviceIntro.paragraphs.map((paragraph) => (
            <Text tag="p" variant="textBase" class="text-muted-foreground text-pretty">
              {paragraph}
            </Text>
          ))}
        </div>
      </div>
      <div class="mt-16 grid gap-x-10 gap-y-24 sm:grid-cols-2">
        {servicePillars.map((pillar) => (
          <div>
            <Text tag="h3" variant="textBase" class="font-medium text-foreground">
              {pillar.title}
            </Text>
            <Text tag="p" variant="textSM" class="mt-1 font-medium text-foreground text-pretty">
              {pillar.tagline}
            </Text>
            <Text tag="p" variant="textSM" class="mt-2 text-muted-foreground text-pretty">
              {pillar.text}
            </Text>
          </div>
        ))}
      </div>
      <div class="mt-24 max-w-xl">
        <Text
          tag="h3"
          variant="displayMD"
          class="tracking-tight text-pretty text-foreground"
        >
          <span class="block">Tu próximo desafío,</span>
          <span class="block">es <em class="font-semibold not-italic">nuestro punto de partida.</em></span>
        </Text>
        <Text tag="p" variant="textBase" class="mt-4 text-muted-foreground text-pretty">
          {serviceClose.text}
        </Text>
        <Button isLink={true} href="/conversemos" size="sm" variant="default" class="mt-8 w-fit">
          {serviceClose.cta}
        </Button>
      </div>
      {showSolutionGrid && (
        <div class="grid mt-16 gap-x-10 gap-y-24 sm:grid-cols-2 lg:grid-cols-3">
          {
            steps.map((step) => (
            <div>
              {showSolutionTitles && (
                <Text tag="h3" variant="textBase" class="font-medium text-foreground">
                  {step.title}
                </Text>
              )}
              {step.kicker &&
                (showSolutionLinks && step.href ? (
                  <Text
                    tag="a"
                    href={step.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    variant="textBase"
                    class:list={[
                      "font-medium text-foreground text-pretty transition-colors hover:text-muted-foreground",
                      showSolutionTitles && "mt-1",
                    ]}
                  >
                    {step.kicker}
                  </Text>
                ) : (
                  <Text
                    tag="h3"
                    variant="textBase"
                    class:list={[
                      "font-medium text-foreground text-pretty",
                      showSolutionTitles && "mt-1",
                    ]}
                  >
                    {step.kicker}
                  </Text>
                ))}
              {Array.isArray(step.text) ? (
                step.text.map((line, lineIndex) => (
                  <Text
                    tag="p"
                    variant="textSM"
                    class:list={[
                      "text-muted-foreground text-pretty",
                      lineIndex === 0 ? "mt-2" : "mt-1",
                    ]}
                  >
                    {line}
                  </Text>
                ))
              ) : (
                <Text tag="p" variant="textSM" class="mt-2 text-muted-foreground text-pretty">
                  {step.text}
                </Text>
              )}
            </div>
            ))
          }
        </div>
      )}
    </LabeledGrid>
  </Wrapper>
</section>
