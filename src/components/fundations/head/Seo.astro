---
import { AstroSeo } from "@lexingtonthemes/seo";

const site = Astro.site ?? new URL("https://livestack.io");
const pageUrl = new URL(Astro.url.pathname, site);
const ogImage = new URL("/og-image.jpg", site);

const title = "Livestack";
const description =
  "Grandes experiencias, mejores negocios. Conecta ventas, audiencias, pagos y operaciones en una sola plataforma.";
---

<AstroSeo
  title={title}
  description={description}
  canonical={pageUrl.href}
  openGraph={{
    url: pageUrl.href,
    title,
    description,
    images: [
      {
        url: ogImage.href,
        width: 1200,
        height: 630,
        alt: "Livestack",
        type: "image/jpeg",
      },
    ],
    site_name: "Livestack",
    type: "website",
    locale: "es_AR",
  }}
  twitter={{
    handle: "@livestack",
    site: "@livestack",
    cardType: "summary_large_image",
  }}
/>