---
import { AstroSeo } from "@lexingtonthemes/seo";

const site = Astro.site ?? new URL("https://withlivestack.com");
const pageUrl = new URL(Astro.url.pathname, site);
const ogImage = new URL("/og-image.jpg", site);

const title = "Livestack";
const description =
  "Grandes experiencias, mejores negocios. Conecta ventas, audiencias, pagos y operaciones en una sola plataforma.";

const ogWidth = "1200";
const ogHeight = "630";

const additionalMetaTags = [
  { property: "og:image", content: ogImage.href },
  { property: "og:image:width", content: ogWidth },
  { property: "og:image:height", content: ogHeight },
  { property: "og:image:type", content: "image/jpeg" },
  { property: "og:image:alt", content: "Livestack" },
  { name: "twitter:image", content: ogImage.href },
];
---

<AstroSeo
  title={title}
  description={description}
  canonical={pageUrl.href}
  openGraph={{
    url: pageUrl.href,
    title,
    description,
    site_name: "Livestack",
    type: "website",
    locale: "es_AR",
  }}
  twitter={{
    handle: "@livestack",
    site: "@livestack",
    cardType: "summary_large_image",
  }}
  additionalMetaTags={additionalMetaTags}
/>