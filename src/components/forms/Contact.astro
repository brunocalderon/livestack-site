---
// Assets
import GradientShader from "@/components/assets/GradientShader.astro";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { grid, mainCol, mainStart } from "@/components/fundations/containers/grid";
const input =
  "block w-full h-10 px-3 text-sm rounded-lg border-0 bg-background text-foreground ring-1 ring-inset ring-border placeholder:text-faint-foreground transition focus:ring-2 focus:ring-primary focus:outline-none";
const channels = [
  { title: "Sales", text: "Plans, security reviews and invoices.", email: "sales@navy.test" },
  { title: "Support", text: "A real engineer, usually within the hour.", email: "support@navy.test" },
  { title: "Press", text: "Interviews, logos and company facts.", email: "press@navy.test" },
];
---

<section class="relative overflow-hidden">
  <div aria-hidden="true" class="absolute inset-x-0 top-0 h-160 arch-gradient"></div>
  <GradientShader class="absolute inset-x-0 top-0 w-full h-160" />
  <div data-nav-dark aria-hidden="true" class="absolute inset-x-0 top-0 h-80"></div>
  <Wrapper variant="standard" class="relative flex flex-col justify-center pt-32 pb-24 min-h-160">
    <div class:list={["grid", grid]}>
      <div class:list={[mainCol, mainStart]}>
        <Text
          tag="h1"
          variant="displayLG"
          class="tracking-tight text-balance text-inverse-foreground"
        >
          Talk to the <em>team</em>
        </Text>
        <Text tag="p" variant="textBase" class="max-w-md mt-6 text-inverse-foreground/70">
          Questions about a plan, a migration or an incident? Send a message
          and the right person will reply.
        </Text>
      </div>
    </div>
  </Wrapper>
  <Wrapper variant="standard" class="relative pb-24">
    <div class:list={["grid", grid]}>
      <div class:list={[mainCol, mainStart]}>
      <dl class="grid gap-8 sm:grid-cols-3">
        {
          channels.map((channel) => (
            <div>
              <dt>
                <Text tag="span" variant="textXS" class="uppercase text-muted-foreground">
                  {channel.title}
                </Text>
              </dt>
              <dd class="mt-3">
                <Text tag="span" variant="textBase" class="block font-medium text-foreground">
                  {channel.email}
                </Text>
                <Text tag="span" variant="textSM" class="block mt-1 text-muted-foreground text-pretty">
                  {channel.text}
                </Text>
              </dd>
            </div>
          ))
        }
      </dl>
      <form class="flex flex-col pt-12 mt-12 border-t gap-5 border-border">
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="name" class="text-sm font-medium text-foreground">Full name</label>
            <input id="name" name="name" type="text" autocomplete="name" placeholder="Lucía Navarro" class:list={[input, "mt-2"]} />
          </div>
          <div>
            <label for="email" class="text-sm font-medium text-foreground">Work email</label>
            <input id="email" name="email" type="email" autocomplete="email" inputmode="email" placeholder="lucia@lexington.test" class:list={[input, "mt-2"]} />
          </div>
        </div>
        <div>
          <label for="topic" class="text-sm font-medium text-foreground">What is it about?</label>
          <select id="topic" name="topic" class:list={[input, "mt-2"]}>
            <option>Plans and pricing</option>
            <option>Moving from another tool</option>
            <option>Help with an incident</option>
            <option>Something else</option>
          </select>
        </div>
        <div>
          <label for="message" class="text-sm font-medium text-foreground">Message</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            placeholder="Tell us a little about your setup."
            class="block w-full px-3 py-2.5 mt-2 text-sm border-0 rounded-lg resize-none bg-background text-foreground ring-1 ring-inset ring-border placeholder:text-faint-foreground transition focus:ring-2 focus:ring-primary focus:outline-none"
          ></textarea>
        </div>
        <Button size="base" variant="default" type="submit" class="self-start mt-2">
          Send message
        </Button>
      </form>
      </div>
    </div>
  </Wrapper>
</section>
