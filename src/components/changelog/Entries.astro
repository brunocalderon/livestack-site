---
// Fundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import LabeledGrid from "@/components/fundations/containers/LabeledGrid.astro";
// Components
import ChangelogEntry from "@/components/changelog/ChangelogEntry.astro";
// Content
import { getCollection } from "astro:content";
const allUpdates = (await getCollection("changelog")).sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);
---

<section>
  <Wrapper variant="standard" class="pt-24 pb-24">
    <LabeledGrid label="Releases">
      <ol class="flex flex-col">
        {allUpdates.map((post, index) => <ChangelogEntry post={post} latest={index === 0} />)}
      </ol>
    </LabeledGrid>
  </Wrapper>
</section>
