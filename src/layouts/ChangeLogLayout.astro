---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { grid, mainCol, mainStart } from "@/components/fundations/containers/grid";
// Icons
import ChevronLeft from "@/components/fundations/icons/ChevronLeft.astro";
import ChevronRight from "@/components/fundations/icons/ChevronRight.astro";
// Content
import { getCollection } from "astro:content";
const { frontmatter } = Astro.props;
const pubDate = new Date(frontmatter.pubDate);
const date = pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const updates = (await getCollection("changelog")).sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);
const index = updates.findIndex((entry) => entry.data.page === frontmatter.page);
const newer = updates[index - 1];
const older = updates[index + 1];
---

<BaseLayout>
  <article>
    <Wrapper variant="standard" class="pt-40 pb-32 lg:pt-52">
      <div class:list={["grid", grid]}>
        <div class:list={["max-w-2xl", mainCol, mainStart]}>
          <a
            href="/changelog/home"
            class="inline-flex items-center gap-1 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
          >
            <ChevronLeft class="size-3.5" aria-hidden="true" />
            Changelog
          </a>
          <Text tag="p" variant="textXS" class="mt-10 uppercase text-muted-foreground">
            <time datetime={pubDate.toISOString()}>{date}</time>
          </Text>
          <Text
            tag="h1"
            variant="displayLG"
            class="mt-4 tracking-tight text-balance text-foreground"
          >
            {frontmatter.page}
          </Text>
          <Text tag="p" variant="textLG" class="mt-6 text-muted-foreground text-pretty">
            {frontmatter.description}
          </Text>
          <Wrapper variant="prose" class="pt-12 mt-12 border-t border-border prose-headings:tracking-tight">
            <slot />
          </Wrapper>
          {
            (newer || older) && (
              <nav aria-label="More updates" class="grid pt-8 mt-16 border-t gap-8 border-border sm:grid-cols-2">
                {older ? (
                  <a href={`/changelog/${older.id}`} class="flex flex-col group">
                    <span class="inline-flex items-center gap-1 text-xs uppercase text-muted-foreground">
                      <ChevronLeft class="size-3 transition-transform group-hover:-translate-x-0.5" aria-hidden="true" />
                      Previous update
                    </span>
                    <Text tag="span" variant="textBase" class="mt-3 font-medium text-balance text-foreground transition-colors group-hover:text-muted-foreground">
                      {older.data.page}
                    </Text>
                  </a>
                ) : (
                  <div class="hidden sm:block" />
                )}
                {newer && (
                  <a href={`/changelog/${newer.id}`} class="flex flex-col items-end group">
                    <span class="inline-flex items-center gap-1 text-xs uppercase text-muted-foreground">
                      Next update
                      <ChevronRight class="size-3 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
                    </span>
                    <Text tag="span" variant="textBase" class="mt-3 font-medium text-end text-balance text-foreground transition-colors group-hover:text-muted-foreground">
                      {newer.data.page}
                    </Text>
                  </a>
                )}
              </nav>
            )
          }
        </div>
      </div>
    </Wrapper>
  </article>
</BaseLayout>
