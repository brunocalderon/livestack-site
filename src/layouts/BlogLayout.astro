---
import { Image } from "astro:assets";
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import LabeledGrid from "@/components/fundations/containers/LabeledGrid.astro";
import ArrowLink from "@/components/fundations/elements/ArrowLink.astro";
import { grid, sideCol, mainCol, mainStart } from "@/components/fundations/containers/grid";
import ChevronLeft from "@/components/fundations/icons/ChevronLeft.astro";
import ChevronRight from "@/components/fundations/icons/ChevronRight.astro";
// Components
import ShareButtons from "@/components/fundations/elements/ShareButtons.astro";
import BlogEntry from "@/components/blog/BlogEntry.astro";
// Sections
import Subscribe from "@/components/blog/Subscribe.astro";
// Content
import { getCollection, getEntry } from "astro:content";
const { frontmatter } = Astro.props;
const team = await getEntry("team", frontmatter.team);
const pubDate = new Date(frontmatter.pubDate);
const date = pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const sortedPosts = (await getCollection("posts")).sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);
const index = sortedPosts.findIndex((post) => post.data.title === frontmatter.title);
const newer = sortedPosts[index - 1];
const older = sortedPosts[index + 1];
const allPosts = sortedPosts.filter((post) => post.data.title !== frontmatter.title);
const related = allPosts.filter((post) =>
  post.data.tags.some((tag) => frontmatter.tags.includes(tag))
);
const morePosts = [...related, ...allPosts.filter((post) => !related.includes(post))].slice(0, 3);
---

<BaseLayout>
  <article>
    <Wrapper variant="standard" class="pt-40 pb-16 lg:pt-52">
      <div class:list={["grid", grid]}>
        <div class:list={[mainCol, mainStart]}>
          <a
            href="/blog/home"
            class="inline-flex items-center gap-1 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
          >
            <ChevronLeft class="size-3.5" aria-hidden="true" />
            All posts
          </a>
          <div class="flex flex-wrap items-center mt-8 gap-x-6 gap-y-3">
            {
              frontmatter.tags.map((tag) => (
                <a
                  href={`/blog/tags/${tag}`}
                  class="text-xs uppercase transition-colors text-foreground hover:text-muted-foreground"
                >
                  {tag}
                </a>
              ))
            }
            <Text tag="span" variant="textXS" class="uppercase text-muted-foreground">
              <time datetime={pubDate.toISOString()}>{date}</time>
            </Text>
          </div>
          <Text
            tag="h1"
            variant="displayLG"
            class="max-w-4xl mt-6 tracking-tight text-balance text-foreground"
          >
            {frontmatter.title}
          </Text>
          <Text tag="p" variant="textLG" class="max-w-2xl mt-6 text-muted-foreground text-pretty">
            {frontmatter.description}
          </Text>
        </div>
      </div>
    </Wrapper>
    <Wrapper variant="standard">
      <div class="overflow-hidden bg-muted aspect-2/1">
        <Image
          width={1600}
          alt={frontmatter.image.alt}
          src={frontmatter.image.url}
          class="object-cover size-full"
        />
      </div>
    </Wrapper>
    <Wrapper variant="standard" class="py-20 lg:py-24">
      <div class:list={["grid gap-12", grid]}>
        <aside class={sideCol}>
          <div class="flex flex-col gap-8 lg:sticky lg:top-28">
            {
              team && (
                <a href={`/team/${team.id}`} class="flex items-center group gap-3">
                  <Image
                    width={96}
                    height={96}
                    src={team.data.image.url}
                    alt={team.data.name}
                    class="object-cover size-10 bg-muted"
                  />
                  <span class="flex flex-col">
                    <Text
                      tag="span"
                      variant="textSM"
                      class="font-medium text-foreground transition-colors group-hover:text-muted-foreground"
                    >
                      {team.data.name}
                    </Text>
                    <Text tag="span" variant="textXS" class="text-muted-foreground">
                      {team.data.role}
                    </Text>
                  </span>
                </a>
              )
            }
            <div class="pt-6 border-t border-border">
              <Text tag="p" variant="textXS" class="uppercase text-muted-foreground">
                Share this post
              </Text>
              <div class="mt-3">
                <ShareButtons description={frontmatter.description} />
              </div>
            </div>
          </div>
        </aside>
        <div class:list={["max-w-2xl", mainCol]}>
          <Wrapper variant="prose" class="prose-headings:tracking-tight">
            <slot />
          </Wrapper>
          {
            (newer || older) && (
              <nav aria-label="More posts" class="grid pt-8 mt-16 border-t gap-8 border-border sm:grid-cols-2">
                {older ? (
                  <a
                    href={`/blog/posts/${older.id}`}
                    class="flex flex-col group"
                  >
                    <span class="inline-flex items-center gap-1 text-xs uppercase text-muted-foreground">
                      <ChevronLeft class="size-3 transition-transform group-hover:-translate-x-0.5" aria-hidden="true" />
                      Previous post
                    </span>
                    <Text tag="span" variant="textBase" class="mt-3 font-medium text-balance text-foreground transition-colors group-hover:text-muted-foreground">
                      {older.data.title}
                    </Text>
                  </a>
                ) : (
                  <div class="hidden sm:block" />
                )}
                {newer && (
                  <a
                    href={`/blog/posts/${newer.id}`}
                    class="flex flex-col items-end group"
                  >
                    <span class="inline-flex items-center gap-1 text-xs uppercase text-muted-foreground">
                      Next post
                      <ChevronRight class="size-3 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
                    </span>
                    <Text tag="span" variant="textBase" class="mt-3 font-medium text-end text-balance text-foreground transition-colors group-hover:text-muted-foreground">
                      {newer.data.title}
                    </Text>
                  </a>
                )}
              </nav>
            )
          }
        </div>
      </div>
    </Wrapper>
  </article>
  {
    morePosts.length > 0 && (
      <section>
        <Wrapper variant="standard" class="pb-32">
          <LabeledGrid label="Keep reading">
            <Text tag="h2" variant="displayMD" class="max-w-2xl text-balance text-foreground">
              More from <em>on call</em>
            </Text>
            <ArrowLink href="/blog/home" class="mt-8">View all posts</ArrowLink>
            <div slot="full" class="grid grid-cols-1 gap-x-8 gap-y-16 md:grid-cols-2 lg:grid-cols-3">
              {morePosts.map((post) => <BlogEntry post={post} />)}
            </div>
          </LabeledGrid>
        </Wrapper>
      </section>
    )
  }
  <Subscribe />
</BaseLayout>
