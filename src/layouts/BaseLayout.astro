---
// Foundations
import "@/styles/global.css";
import BaseHead from "@/components/fundations/head/BaseHead.astro";
import SmoothScroll from "@/components/fundations/scripts/SmoothScroll.astro";

// Components
import Footer from "@/components/global/Footer.astro";
import Navigation from "@/components/global/Navigation.astro";
// Hides nav and footer on selected screens by passing
// the hideNav and hideFooter props
// <BaseLayout hideNav={true} hideFooter={true}>
// navTone="dark" is for pages that open on an ink band
const {
  hideNav = false,
  hideFooter = false,
  hideFooterCta = false,
  navTone = "light",
  navMinimal = false,
} = Astro.props;
---

<html lang="en" class="selection:bg-inverse selection:text-inverse-foreground">
  <head>
    <BaseHead />
  </head>
  <body class="relative flex flex-col bg-background min-h-svh">
    {!hideNav && <Navigation tone={navTone} minimal={navMinimal} />}

    <main class="relative z-10 grow">
      <div class="relative"><slot /></div>
    </main>
    {!hideFooter && <Footer showCta={!hideFooterCta} />}
    <SmoothScroll />
  </body>
</html>
