---
// Assets
import { Image } from "astro:assets";
import GradientShader from "@/components/assets/GradientShader.astro";
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import ArrowLink from "@/components/fundations/elements/ArrowLink.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import LabeledGrid from "@/components/fundations/containers/LabeledGrid.astro";
import { grid, mainCol, mainStart } from "@/components/fundations/containers/grid";
import ChevronLeft from "@/components/fundations/icons/ChevronLeft.astro";
// Components
import CustomerEntry1 from "@/components/customers/CustomerEntry1.astro";
// Content
import { getCollection } from "astro:content";
const { frontmatter } = Astro.props;
const more = (await getCollection("customers"))
  .filter((entry) => entry.data.customer !== frontmatter.customer)
  .slice(0, 3);
const tones = [
  { ground: "bg-inverse", ink: "text-inverse-foreground", soft: "text-inverse-foreground/75" },
  { ground: "bg-primary", ink: "text-inverse-foreground", soft: "text-inverse-foreground/75" },
  { ground: "bg-lilac", ink: "text-foreground", soft: "text-muted-foreground" },
];
---

<BaseLayout>
  <article>
    <Wrapper variant="standard" class="pt-40 lg:pt-52">
      <div class:list={["grid", grid]}>
        <div class:list={[mainCol, mainStart]}>
          <a
            href="/customers/home"
            class="inline-flex items-center gap-1 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
          >
            <ChevronLeft class="size-3.5" aria-hidden="true" />
            Customer stories
          </a>
          <div class="flex items-center gap-3 mt-10">
            <Image src={frontmatter.logo.url} alt={frontmatter.logo.alt} width={48} height={48} class="size-6" />
            <Text tag="p" variant="textBase" class="font-medium text-foreground">
              {frontmatter.customer}
            </Text>
          </div>
          <Text
            tag="h1"
            variant="displayLG"
            class="max-w-4xl mt-6 tracking-tight text-balance text-foreground"
          >
            {frontmatter.ctaTitle}
          </Text>
          <Text tag="p" variant="textLG" class="max-w-2xl mt-6 text-muted-foreground text-pretty">
            {frontmatter.about}
          </Text>
        </div>
      </div>
      <dl class="grid grid-cols-2 pt-6 mt-16 border-t gap-x-8 gap-y-6 border-border md:grid-cols-3 lg:grid-cols-5">
        {
          Object.entries(frontmatter.details).map(([key, value]) => (
            <div>
              <dt>
                <Text tag="span" variant="textXS" class="uppercase text-muted-foreground">
                  {key}
                </Text>
              </dt>
              <dd class="mt-1">
                <Text tag="span" variant="textSM" class="text-foreground">
                  {value}
                </Text>
              </dd>
            </div>
          ))
        }
      </dl>
      <div class="relative flex items-center justify-center mt-16 overflow-hidden aspect-4/3 md:aspect-video">
        <div aria-hidden="true" class="absolute inset-0 arch-gradient"></div>
        <GradientShader class="absolute inset-0 size-full" />
        <Image
          src={frontmatter.logo.url}
          alt={frontmatter.logo.alt}
          width={384}
          height={384}
          class="relative size-24 md:size-40"
        />
      </div>
    </Wrapper>
    {
      frontmatter.challengesAndSolutions.map((item) => (
        <Wrapper variant="standard" class="pt-24">
          <LabeledGrid label={item.title}>
            <Text tag="p" variant="displaySM" class="max-w-3xl text-balance text-foreground">
              {item.content}
            </Text>
          </LabeledGrid>
        </Wrapper>
      ))
    }
    <Wrapper variant="standard" class="pt-24">
      <LabeledGrid label="Results">
        <ul slot="full" role="list" class="grid md:grid-cols-3">
          {
            frontmatter.results.map((result, index) => {
              const tone = tones[index % tones.length];
              return (
                <li class:list={["flex flex-col p-6 gap-24 lg:gap-62", tone.ground]}>
                  <Text tag="p" variant="textXS" class:list={["uppercase", tone.soft]}>
                    Result {String(index + 1).padStart(2, "0")}
                  </Text>
                  <Text tag="p" variant="textBase" class:list={["font-medium text-balance", tone.ink]}>
                    {result}
                  </Text>
                </li>
              );
            })
          }
        </ul>
      </LabeledGrid>
    </Wrapper>
    <Wrapper variant="standard" class="py-24">
      <LabeledGrid label="Story">
        <Wrapper variant="prose" class="max-w-2xl prose-headings:tracking-tight">
          <slot />
        </Wrapper>
      </LabeledGrid>
    </Wrapper>
  </article>
  <section>
    <Wrapper variant="standard">
      <figure class="flex flex-col p-8 gap-16 bg-primary lg:p-10">
        <blockquote>
          <Text tag="p" variant="displayMD" class="max-w-4xl tracking-tight text-balance text-inverse-foreground">
            “{frontmatter.testimonial}”
          </Text>
        </blockquote>
        <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
          <figcaption>
            <Text tag="p" variant="textBase" class="font-medium text-inverse-foreground">
              {frontmatter.customer}
            </Text>
            <Text tag="p" variant="textSM" class="max-w-sm mt-1 text-inverse-foreground/75">
              {frontmatter.partnership}
            </Text>
          </figcaption>
          <Button isLink={true} size="base" variant="default" href="/forms/sign-up">
            Start monitoring for free
          </Button>
        </div>
      </figure>
    </Wrapper>
  </section>
  {
    more.length > 0 && (
      <section>
        <Wrapper variant="standard" class="py-24 lg:py-32">
          <LabeledGrid label="More stories">
            <Text tag="h2" variant="displayMD" class="max-w-2xl text-balance text-foreground">
              More teams <em>on Navy</em>
            </Text>
            <ArrowLink href="/customers/home" class="mt-8">View all stories</ArrowLink>
            <ul slot="full" role="list" class="grid grid-cols-1 border-t border-l border-border md:grid-cols-2 lg:grid-cols-3">
              {more.map((post) => <CustomerEntry1 post={post} />)}
            </ul>
          </LabeledGrid>
        </Wrapper>
      </section>
    )
  }
</BaseLayout>
